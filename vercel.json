{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/backend/frontend/assets/$1"
    },
    {
      "source": "/sw.js",
      "destination": "/backend/frontend/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/backend/frontend/manifest.json"
    },
    {
      "source": "/",
      "destination": "/backend/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/backend/frontend/$1"
    }
  ]
}
