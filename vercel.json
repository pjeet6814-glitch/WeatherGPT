{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route__=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__route__="
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
